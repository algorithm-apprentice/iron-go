{
  "identifier": "dev.irongo.e2e",
  "productName": "Iron Go Acceptance",
  "mainBinaryName": "iron-go-acceptance",
  "build": { "frontendDist": "../dist-e2e", "beforeBuildCommand": "npm run build:acceptance" },
  "app": { "security": { "capabilities": [
    "main-window",
    { "identifier": "acceptance-window", "windows": ["main"], "permissions": ["core:window:allow-set-size", "core:window:allow-set-focus", "core:window:allow-destroy"] }
  ] } }
}
