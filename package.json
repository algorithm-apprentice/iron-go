{
  "name": "iron-go",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "engines": { "node": ">=24" },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "test": "node --test tests/*.test.mjs",
    "test:rust": "cargo test --locked --manifest-path src-tauri/Cargo.toml",
    "test:fixture": "cd examples/orbit && go test ./...",
    "test:ui": "node --test tests/ui/*.test.mjs",
    "test:native": "node tests/native/workbench.mjs",
    "check": "npm run typecheck && npm test && cargo fmt --manifest-path src-tauri/Cargo.toml --check && npm run test:rust && npm run test:fixture",
    "test:feedback": "npm run check && npm run test:ui && npm run test:native -- --require-gopls"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "dompurify": "3.4.18",
    "monaco-editor": "0.57.0",
    "vscode-jsonrpc": "8.2.1",
    "vscode-languageserver-types": "3.17.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "playwright": "1.63.0",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  },
  "overrides": {
    "monaco-editor": { "dompurify": "$dompurify" }
  }
}
